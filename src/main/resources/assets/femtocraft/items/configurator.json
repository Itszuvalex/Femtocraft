{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:component",
    "component": "femtocraft:configurator_mode",
    "cases": [
      {
        "when": "ITEM",
        "model": {
          "type": "minecraft:model",
          "model": "femtocraft:item/configurator_item"
        }
      },
      {
        "when": "FLUID",
        "model": {
          "type": "minecraft:model",
          "model": "femtocraft:item/configurator_fluid"
        }
      },
      {
        "when": "NANITE",
        "model": {
          "type": "minecraft:model",
          "model": "femtocraft:item/configurator_nanite"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "femtocraft:item/configurator_item"
    }
  }
}
