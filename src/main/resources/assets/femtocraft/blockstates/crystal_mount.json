{
  "multipart": [
    {
      "when": {
        "OR": [
          {
            "bottom": "true"
          },
          {
            "top": "false"
          }
        ]
      },
      "apply": {
        "model": "femtocraft:block/crystal_mount"
      }
    },
    {
      "when": {
        "top": "true"
      },
      "apply": {
        "model": "femtocraft:block/crystal_mount_top"
      }
    }
  ]
}
