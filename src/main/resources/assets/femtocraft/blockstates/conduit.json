{
  "multipart": [
    {
      "apply": {
        "model": "femtocraft:block/conduit"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "femtocraft:block/conduit_north"
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "femtocraft:block/conduit_south"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "femtocraft:block/conduit_east"
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "femtocraft:block/conduit_west"
      }
    },
    {
      "when": {
        "up": "true"
      },
      "apply": {
        "model": "femtocraft:block/conduit_up"
      }
    },
    {
      "when": {
        "down": "true"
      },
      "apply": {
        "model": "femtocraft:block/conduit_down"
      }
    }
  ]
}
